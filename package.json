{
  "name": "yukia-seo-blog",
  "version": "2.0.0",
  "private": true,
  "description": "Yukia 的独立站 SEO、海外内容运营与 Digital Growth 个人博客",
  "scripts": {
    "clean": "hexo clean",
    "build": "npm run validate:content && hexo clean && hexo generate && npm run validate:site",
    "serve": "hexo server",
    "validate:content": "python3 tools/validate_posts.py source/_posts",
    "validate:site": "python3 tools/check_site.py public"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "7.3.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "3.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
